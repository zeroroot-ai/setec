# kata.env — the ONE place the kata-containers release is pinned (setec#26,
# epic zeroroot-ai/.github#20).
#
# Three consumers read this file and carry no version of their own:
#   Dockerfile.installer          build args from .github/workflows/images.yml
#                                 (or `make installer-image` locally)
#   development/k3s/scripts/20-install-kata.sh   sources it
#   packer/eks-kata-fc-ami/bake.sh                sources it, passes -var
# scripts/check-kata-pin.sh fails CI when any of them re-adds a literal.
#
# To bump: change both lines. KATA_SHA256 is the sha256 of
# kata-go-static-<KATA_VERSION>-amd64.tar.zst (upstream ships no sidecar).
# zeroroot-ai/.github version-links.yaml watches upstream releases.
KATA_VERSION=4.1.0
KATA_SHA256=8b32080424c884238ee8d52060fdfd060fbe2b5fdfa4eb9ff2772b382b432b55
