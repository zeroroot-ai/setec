# firecracker.env — the ONE place the Firecracker release of the launcher
# image is pinned (docs/design/runtime.md).
#
# Consumers carry no version of their own:
#   Dockerfile.launcher   build args from .github/workflows/images.yml
# scripts/check-runtime-pins.sh fails CI when a second place names the version.
#
# To bump: change both lines. FIRECRACKER_SHA256 is the sha256 of
# firecracker-<version>-x86_64.tgz, which the release publishes as
# firecracker-<version>-x86_64.tgz.sha256.txt.
FIRECRACKER_VERSION=v1.17.0
FIRECRACKER_SHA256=06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558
