# More info: https://docs.docker.com/engine/reference/builder/#dockerignore-file
# Ignore everything by default and re-include only needed files
**

# Re-include Go source files (but not *_test.go)
!**/*.go
**/*_test.go

# Re-include Go module files
!go.mod
!go.sum

# Re-include the module-download retry wrapper. Both Dockerfiles run
# `go mod download` through it, before `COPY . .`, so it has to be in the
# context on its own. See scripts/go-retry.sh.
!scripts/go-retry.sh

# Re-include the license text. `**` above hides it, and both Dockerfiles
# copy it into /licenses so the published images carry it (Apache-2.0 §4(a)).
!LICENSE

# Re-include the guest kernel pin, its config and its build script.
# Dockerfile.launcher builds the guest kernel from them.
!kernel/kernel.env
!kernel/x86_64.defconfig
!scripts/build-guest-kernel.sh
