# syntax=docker/dockerfile:1
# The disk builder image (docs/design/storage.md): setec-disk-builder and
# mksquashfs 4.6, which reads the image as a tar stream (-tar).
FROM --platform=$BUILDPLATFORM ghcr.io/zeroroot-ai/mirror/golang:1.27.2@sha256:5bc7f572bbaa98885a3a1fd9c0aa76b59e3e14e8628bfc316bbfd0c701e4818c AS builder
# GOTOOLCHAIN=local makes a toolchain mismatch fail the build instead of
# downloading a toolchain.
ARG GOTOOLCHAIN=local
ENV GOTOOLCHAIN=${GOTOOLCHAIN}
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api/ api/
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/setec-disk-builder ./cmd/setec-disk-builder

FROM ghcr.io/zeroroot-ai/mirror/alpine:3.22@sha256:5291449c3df73caf6ed85e649dec1b9e818b39a5d8c871e97afc13e9cd5e8fa8
# APT_CACHE_BUST makes `apk upgrade` run on each build. The base is
# digest-pinned, so only the upgrade brings the Alpine fixes that land after
# the base (setec#97: zlib 1.3.2-r1). The org image workflow passes the run id,
# so the buildx cache cannot replay an old upgrade layer.
ARG APT_CACHE_BUST=0
RUN echo "apk refresh ${APT_CACHE_BUST}" >/dev/null \
 && apk upgrade --no-cache \
 && apk add --no-cache squashfs-tools
COPY --from=builder /out/setec-disk-builder /usr/local/bin/setec-disk-builder
COPY LICENSE /licenses/LICENSE
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/setec-disk-builder"]
