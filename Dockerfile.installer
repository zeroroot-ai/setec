# syntax=docker/dockerfile:1.7

# Dockerfile.installer — the portable node installer image (ADR-0003,
# issue #187). Unlike the shared ./Dockerfile (pure Go binaries), this
# image also carries the stock kata-containers static release as an
# immutable payload, kata-deploy-style: the only network fetch a node
# ever performs is the image pull itself, which keeps the installer
# air-gap-friendly and makes the payload version an image property that
# release engineering pins, not a runtime download a node performs.
#
# amd64 only: kata-fc is x86-only in setec (ADR-0001), and the chart's
# installer DaemonSet pins kubernetes.io/arch: amd64.

# ----------------------------------------------------------------------------
# Build stage — same toolchain pin as ./Dockerfile (gibson#777).
# ----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM ghcr.io/zeroroot-ai/mirror/golang:1.26.6@sha256:0d1d3a794be25f809dd2cb3160d8c73276c4056a9f8242a138e908ddeee7b6b6 AS builder
# The golang base image ships GOTOOLCHAIN=local. go.mod names the toolchain
# (go 1.26.8 after the stdlib fix) and moves faster than the mirrored image tag,
# so let the Go toolchain download the version go.mod asks for. Same rule as
# gibson's Dockerfile.
ENV GOTOOLCHAIN=auto
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace

COPY go.mod go.mod
COPY go.sum go.sum
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
      go build -trimpath -ldflags="-s -w" -o /out/installer ./cmd/installer

# ----------------------------------------------------------------------------
# Payload stage — fetch, verify, extract and prune the kata static release.
# ----------------------------------------------------------------------------
FROM ghcr.io/zeroroot-ai/mirror/golang:1.26.6@sha256:0d1d3a794be25f809dd2cb3160d8c73276c4056a9f8242a138e908ddeee7b6b6 AS payload
# The golang base image ships GOTOOLCHAIN=local. go.mod names the toolchain
# (go 1.26.8 after the stdlib fix) and moves faster than the mirrored image tag,
# so let the Go toolchain download the version go.mod asks for. Same rule as
# gibson's Dockerfile.
ENV GOTOOLCHAIN=auto
# Pinned kata release + digest. To bump: download the new
# kata-go-static-<ver>-amd64.tar.zst, compute sha256sum, update BOTH args
# (and the packer AMI pin, which must match: same payload on every node).
#
# Since kata 4.0 the release ships two tarballs. kata-static-<ver> carries
# only the Rust runtime (runtime-rs), which has no Firecracker hypervisor.
# The Go shim (containerd-shim-kata-v2), Firecracker and the jailer live in
# kata-go-static-<ver>. Upstream calls the Go runtime deprecated but still
# ships it with fixes (4.1.0 is built with Go 1.25.13). Owner decision
# 2026-09-07: setec stays on the Firecracker path and takes the go-static
# payload (docs/code-scanning-dismissals.md, Entry 9).
ARG KATA_VERSION=4.1.0
ARG KATA_SHA256=8b32080424c884238ee8d52060fdfd060fbe2b5fdfa4eb9ff2772b382b432b55

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends zstd; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    curl -fsSL --retry 3 -o /tmp/kata.tar.zst \
      "https://github.com/kata-containers/kata-containers/releases/download/${KATA_VERSION}/kata-go-static-${KATA_VERSION}-amd64.tar.zst"; \
    echo "${KATA_SHA256}  /tmp/kata.tar.zst" | sha256sum -c -; \
    mkdir -p /payload; \
    # Extract only what the kata-fc handler needs. The full tarball also
    # carries QEMU/CLH/TDX/SNP/NVIDIA variants that would quintuple the
    # image for nothing.
    #
    # kata-runtime and kata-collect-data.sh are deliberately NOT extracted
    # (setec#284). containerd resolves runtime_type
    # "io.containerd.kata-fc.v2" straight to containerd-shim-kata-v2, so
    # the kata-runtime CLI and the debug collector are never executed by
    # any setec code path — they were pure payload weight, and being Go
    # binaries they carried the whole kata build's stdlib/dependency CVE
    # surface onto every sandbox host for nothing. Anything that needs
    # kata-runtime is a bake-time AMI concern (packer/), not a node one.
    tar --zstd -xf /tmp/kata.tar.zst -C /payload \
      ./opt/kata/VERSION \
      ./opt/kata/bin/containerd-shim-kata-v2 \
      ./opt/kata/bin/firecracker \
      ./opt/kata/bin/jailer \
      ./opt/kata/share/defaults \
      ./opt/kata/share/kata-containers; \
    rm /tmp/kata.tar.zst; \
    # Prune guest kernels/rootfs images the FC config does not reference,
    # keeping the vmlinux.container / kata-containers.img symlinks plus
    # their full resolution chains.
    cd /payload/opt/kata/share/kata-containers; \
    keep="vmlinux.container kata-containers.img"; \
    for f in vmlinux.container kata-containers.img; do \
      t="$f"; \
      while [ -L "$t" ]; do t="$(basename "$(readlink "$t")")"; keep="$keep $t"; done; \
    done; \
    for f in *; do \
      case " $keep " in *" $f "*) ;; *) rm -rf "$f" ;; esac; \
    done

# Payload gate: everything the kata-fc handler needs at runtime must be
# in the pruned tree, including the kernel/image the FC config points at.
# A bad prune fails the image build, never a node.
RUN set -eux; \
    test -x /payload/opt/kata/bin/containerd-shim-kata-v2; \
    test -x /payload/opt/kata/bin/firecracker; \
    test -x /payload/opt/kata/bin/jailer; \
    # Negative gate (setec#284): the unused kata CLI/debug binaries must
    # stay out. Re-adding either to the extract list above fails here
    # rather than silently re-importing their CVE surface.
    test ! -e /payload/opt/kata/bin/kata-runtime; \
    test ! -e /payload/opt/kata/bin/kata-collect-data.sh; \
    fc_conf=/payload/opt/kata/share/defaults/kata-containers/configuration-fc.toml; \
    test -f "$fc_conf"; \
    kernel="$(awk -F'"' '$1 ~ /^kernel = $/ {print $2; exit}' "$fc_conf")"; \
    image="$(awk -F'"' '$1 ~ /^image = $/ {print $2; exit}' "$fc_conf")"; \
    test -e "/payload$kernel"; \
    test -e "/payload$image"; \
    grep -qx "${KATA_VERSION}" /payload/opt/kata/VERSION

# ----------------------------------------------------------------------------
# Runtime stage — distroless static; the binary chroots into the host
# mount to run host tools, so the image itself needs no shell.
# ----------------------------------------------------------------------------
FROM ghcr.io/zeroroot-ai/mirror/distroless-static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

WORKDIR /

COPY --from=builder /out/installer /entrypoint
COPY --from=payload /payload/opt/kata /opt/kata

# Root on purpose: the installer writes /opt/kata, /etc/systemd and
# /etc/containerd ON THE HOST through the hostPath mount, and restarts
# containerd. The DaemonSet pod is privileged by design (see the chart's
# installer values and SECURITY.md); dropping to 65532 here would only
# break the host writes while conveying no isolation.
USER 0:0

ENTRYPOINT ["/entrypoint"]
