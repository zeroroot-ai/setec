# syntax=docker/dockerfile:1.7

# Dockerfile.installer — the portable node installer image (ADR-0003,
# issue #187). Unlike the shared ./Dockerfile (pure Go binaries), this
# image also carries the stock kata-containers static release as an
# immutable payload, kata-deploy-style: the only network fetch a node
# ever performs is the image pull itself, which keeps the installer
# air-gap-friendly and makes the payload version an image property that
# release engineering pins, not a runtime download a node performs.
#
# amd64 only: kata-fc is x86-only in setec (ADR-0001), and the chart's
# installer DaemonSet pins kubernetes.io/arch: amd64.

# ----------------------------------------------------------------------------
# Build stage — same toolchain pin as ./Dockerfile (gibson#777).
# ----------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM ghcr.io/zeroroot-ai/mirror/golang:1.27.1@sha256:e0174e51e81218523251d85d248a90d24c3d5e81543b4f07a5d66229397db190 AS builder
# The builder image carries exactly the Go that go.mod names, and the org
# guard (check-go-toolchain.sh, .github#22) fails a PR where they differ.
# GOTOOLCHAIN=local makes a mismatch fail the build instead of downloading a
# toolchain, so the pinned base is the toolchain that built the binary.
ARG GOTOOLCHAIN=local
ENV GOTOOLCHAIN=${GOTOOLCHAIN}
ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace

COPY go.mod go.mod
COPY go.sum go.sum
# Through the retry wrapper: proxy.golang.org resets an in-flight HTTP/2
# stream from time to time, and Go reports that as a build failure. It is the
# same wrapper the Makefile uses for `go install`, and it still never retries a
# checksum mismatch. It is COPYed separately so this layer's cache key stays
# go.mod + go.sum + the wrapper, and does not become the whole tree.
COPY scripts/go-retry.sh scripts/go-retry.sh
RUN ./scripts/go-retry.sh go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
      go build -trimpath -ldflags="-s -w" -o /out/installer ./cmd/installer

# ----------------------------------------------------------------------------
# Payload stage — fetch, verify, extract and prune the kata static release.
# ----------------------------------------------------------------------------
FROM ghcr.io/zeroroot-ai/mirror/golang:1.27.1@sha256:e0174e51e81218523251d85d248a90d24c3d5e81543b4f07a5d66229397db190 AS payload
# The builder image carries exactly the Go that go.mod names, and the org
# guard (check-go-toolchain.sh, .github#22) fails a PR where they differ.
# GOTOOLCHAIN=local makes a mismatch fail the build instead of downloading a
# toolchain, so the pinned base is the toolchain that built the binary.
ARG GOTOOLCHAIN=local
ENV GOTOOLCHAIN=${GOTOOLCHAIN}
# Pinned kata release + digest. Both come from kata.env at the repo root,
# the one place the pin is edited (setec#26). The ARGs carry NO default on
# purpose: a build that forgets them fails at the gate below instead of
# fetching a version this file never named. images.yml reads kata.env and
# passes both as build args; locally `make installer-image` does the same.
#
# Since kata 4.0 the release ships two tarballs. kata-static-<ver> carries
# only the Rust runtime (runtime-rs), which has no Firecracker hypervisor.
# The Go shim (containerd-shim-kata-v2), Firecracker and the jailer live in
# kata-go-static-<ver>. Upstream calls the Go runtime deprecated but still
# ships it with fixes. Owner decision 2026-09-07: setec stays on the
# Firecracker path and takes the go-static payload
# (docs/code-scanning-dismissals.md, Entry 9).
ARG KATA_VERSION
ARG KATA_SHA256

ARG GVISOR_VERSION
ARG GVISOR_SHA256

# Pin gate: every build arg must be set (kata.env and gvisor.env are the sources).
RUN set -eu; \
    test -n "${KATA_VERSION}" || { echo "KATA_VERSION build arg is empty: pass it from kata.env" >&2; exit 1; }; \
    test -n "${KATA_SHA256}" || { echo "KATA_SHA256 build arg is empty: pass it from kata.env" >&2; exit 1; }; \
    test -n "${GVISOR_VERSION}" || { echo "GVISOR_VERSION build arg is empty: pass it from gvisor.env" >&2; exit 1; }; \
    test -n "${GVISOR_SHA256}" || { echo "GVISOR_SHA256 build arg is empty: pass it from gvisor.env" >&2; exit 1; }

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends zstd; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    curl -fsSL --retry 3 -o /tmp/kata.tar.zst \
      "https://github.com/kata-containers/kata-containers/releases/download/${KATA_VERSION}/kata-go-static-${KATA_VERSION}-amd64.tar.zst"; \
    echo "${KATA_SHA256}  /tmp/kata.tar.zst" | sha256sum -c -; \
    mkdir -p /payload; \
    # Extract only what the kata-fc handler needs. The full tarball also
    # carries QEMU/CLH/TDX/SNP/NVIDIA variants that would quintuple the
    # image for nothing.
    #
    # kata-runtime and kata-collect-data.sh are deliberately NOT extracted
    # (setec#284). containerd resolves runtime_type
    # "io.containerd.kata-fc.v2" straight to containerd-shim-kata-v2, so
    # the kata-runtime CLI and the debug collector are never executed by
    # any setec code path — they were pure payload weight, and being Go
    # binaries they carried the whole kata build's stdlib/dependency CVE
    # surface onto every sandbox host for nothing. Anything that needs
    # kata-runtime is a bake-time AMI concern (packer/), not a node one.
    tar --zstd -xf /tmp/kata.tar.zst -C /payload \
      ./opt/kata/VERSION \
      ./opt/kata/bin/containerd-shim-kata-v2 \
      ./opt/kata/bin/firecracker \
      ./opt/kata/bin/jailer \
      ./opt/kata/share/defaults \
      ./opt/kata/share/kata-containers; \
    rm /tmp/kata.tar.zst; \
    # Prune guest kernels/rootfs images the FC config does not reference,
    # keeping the vmlinux.container / kata-containers.img symlinks plus
    # their full resolution chains.
    cd /payload/opt/kata/share/kata-containers; \
    keep="vmlinux.container kata-containers.img"; \
    for f in vmlinux.container kata-containers.img; do \
      t="$f"; \
      while [ -L "$t" ]; do t="$(basename "$(readlink "$t")")"; keep="$keep $t"; done; \
    done; \
    for f in *; do \
      case " $keep " in *" $f "*) ;; *) rm -rf "$f" ;; esac; \
    done

# gVisor payload. Shipped WHOLE, deliberately, unlike the kata prune above.
#
# Measured on release-20260928.0: with only runsc and containerd-shim-runsc-v1
# on disk, runsc dies at sandbox creation with `sidecar "gvisor_sentry" not
# usable ... --sidecar-usage-policy is set to STRICT`. The sentry is a separate
# binary under gvisor-bin/ in modern releases. The only policy that works
# without it is LEGACY_DEPRECATED_SLOW_EMBEDDED_FALLBACK, which upstream named
# deprecated AND slow — and it would sit on the cold-start path this repo
# exports as setec_sandbox_cold_start_seconds, for the one backend chosen
# because it has LOWER overhead than a microVM. Owner decision 2026-10-02:
# ship the payload, 95 MB -> ~258 MB compressed.
#
# /opt/gvisor mirrors /opt/kata: runsc resolves gvisor-bin/ relative to the
# RESOLVED target of its own path, so a /usr/local/bin symlink works (verified
# both ways, rc=0). Upstream publishes no loose runsc binary — the URL the
# gVisor docs still name returns 404 — so this is one tarball, checksum-pinned.
RUN set -eux; \
    curl -fsSL --retry 3 -o /tmp/gvisor.tar.zst \
      "https://github.com/google/gvisor/releases/download/${GVISOR_VERSION}/gvisor-x86_64.tar.zstd"; \
    echo "${GVISOR_SHA256}  /tmp/gvisor.tar.zst" | sha256sum -c -; \
    mkdir -p /payload/opt/gvisor; \
    tar --zstd -xf /tmp/gvisor.tar.zst -C /payload/opt/gvisor; \
    rm /tmp/gvisor.tar.zst; \
    printf '%s\n' "${GVISOR_VERSION}" > /payload/opt/gvisor/VERSION

# ----------------------------------------------------------------------------
# Payload gate — its own stage so the gate can be proven to fail.
#
# Everything the kata-fc handler needs at runtime must be in the pruned
# tree, including the kernel/image the FC config points at, and nothing
# else may be. A bad prune fails the image build, never a node.
#
# PAYLOAD_MUTATION is the mutation hook (setec#17): a name here is touched
# into the bin directory before the gate runs, and the build MUST fail. The
# tree-guards workflow and `make installer-payload-guard` build this stage
# twice, once plain and once mutated, and pass only when the plain build
# passes and the mutated one fails. A guard that cannot fail is the
# recurring defect class in this org; this is how this one is shown to.
# The hook cannot ship anything: a mutated build never reaches the runtime
# stage, because the gate below refuses it.
# ----------------------------------------------------------------------------
FROM payload AS payload-gate
ARG PAYLOAD_MUTATION=""
RUN set -eu; \
    if [ -n "${PAYLOAD_MUTATION}" ]; then \
      echo "PAYLOAD_MUTATION=${PAYLOAD_MUTATION}: planting a junk binary; this build must fail at the gate" >&2; \
      : > "/payload/opt/kata/bin/${PAYLOAD_MUTATION}"; \
    fi
RUN set -eu; \
    if [ -n "${PAYLOAD_MUTATION}" ]; then \
      echo "PAYLOAD_MUTATION=${PAYLOAD_MUTATION}: also removing the gvisor sentry; this build must fail at the gate" >&2; \
      rm -f /payload/opt/gvisor/gvisor-bin/gvisor_sentry; \
    fi
RUN set -eux; \
    # Positive inventory (setec#17): bin holds exactly the three binaries
    # the kata-fc handler runs, each executable. This replaces the two
    # named negative tests from setec#284: an extract-list entry not in
    # this set fails here whatever its name, so the list cannot silently
    # grow and re-import a binary's CVE surface onto every sandbox host.
    have="$(ls -A /payload/opt/kata/bin | LC_ALL=C sort | paste -sd' ')"; \
    want="containerd-shim-kata-v2 firecracker jailer"; \
    test "$have" = "$want" || { echo "payload bin inventory is '$have', declared '$want'" >&2; exit 1; }; \
    test -x /payload/opt/kata/bin/containerd-shim-kata-v2; \
    test -x /payload/opt/kata/bin/firecracker; \
    test -x /payload/opt/kata/bin/jailer; \
    fc_conf=/payload/opt/kata/share/defaults/kata-containers/configuration-fc.toml; \
    test -f "$fc_conf"; \
    kernel="$(awk -F'"' '$1 ~ /^kernel = $/ {print $2; exit}' "$fc_conf")"; \
    image="$(awk -F'"' '$1 ~ /^image = $/ {print $2; exit}' "$fc_conf")"; \
    test -e "/payload$kernel"; \
    test -e "/payload$image"; \
    grep -qx "${KATA_VERSION}" /payload/opt/kata/VERSION
RUN set -eux; \
    # gVisor: positive inventory, same contract as the kata bin check above. The
    # sentry is the one every sandbox launch needs — runsc refuses to create a
    # sandbox without it under the default (STRICT) sidecar policy — so its
    # absence must fail the image build, never a node.
    test -x /payload/opt/gvisor/runsc; \
    test -x /payload/opt/gvisor/containerd-shim-runsc-v1; \
    test -x /payload/opt/gvisor/gvisor-bin/gvisor_sentry; \
    have="$(ls -A /payload/opt/gvisor | LC_ALL=C sort | paste -sd' ')"; \
    want="VERSION containerd-shim-runsc-v1 gvisor-bin runsc"; \
    test "$have" = "$want" || { echo "gvisor payload inventory is '$have', declared '$want'" >&2; exit 1; }; \
    grep -qx "${GVISOR_VERSION}" /payload/opt/gvisor/VERSION

# ----------------------------------------------------------------------------
# Runtime stage — distroless static; the binary chroots into the host
# mount to run host tools, so the image itself needs no shell.
# ----------------------------------------------------------------------------
FROM ghcr.io/zeroroot-ai/mirror/distroless-static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

WORKDIR /

COPY --from=builder /out/installer /entrypoint
COPY --from=payload-gate /payload/opt/kata /opt/kata
# The gVisor tree, from the gated stage so a payload that failed the inventory
# above can never reach the runtime image. /opt/gvisor matches the installer's
# --gvisor-payload-dir default, and runsc resolves gvisor-bin/ relative to the
# resolved target of its own path, so the directory layout is load-bearing
# (setec#89).
COPY --from=payload-gate /payload/opt/gvisor /opt/gvisor

# Apache-2.0 §4(a) requires that every recipient of a distribution gets a
# copy of the License, and a published image is a distribution. /licenses
# is the OCI convention. Last in the stage, so it cannot bust the cache
# of the layers above it.
COPY LICENSE /licenses/LICENSE

# Root on purpose: the installer writes /opt/kata, /etc/systemd and
# /etc/containerd ON THE HOST through the hostPath mount, and restarts
# containerd. The DaemonSet pod is privileged by design (see the chart's
# installer values and SECURITY.md); dropping to 65532 here would only
# break the host writes while conveying no isolation.
USER 0:0

ENTRYPOINT ["/entrypoint"]
