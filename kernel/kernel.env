# kernel.env — the ONE place the guest kernel of a launcher machine is pinned.
#
# Consumers carry no version of their own:
#   scripts/build-guest-kernel.sh            builds vmlinux from this pin
#   .github/workflows/guest-kernel.yml       runs the build on a release tag
#   .github/workflows/guest-kernel-currency.yml  fails when 6.1 has a later release
# scripts/check-runtime-pins.sh fails CI when a second place names a version.
#
# To bump (docs/guest-kernel.md): change both lines. KERNEL_SHA256 is the line
# of linux-<version>.tar.xz in https://cdn.kernel.org/pub/linux/kernel/v6.x/sha256sums.asc.
KERNEL_VERSION=6.1.189
KERNEL_SHA256=3ec834a2fefc9a08aac62f993525d7acd10163db6f01d63b4549cbff3f5c9439
